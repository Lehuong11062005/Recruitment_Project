VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# true: cho phép mô phỏng thao tác profile/apply/AI trên UI, không lưu backend
VITE_CANDIDATE_DEMO_MODE=false

# API tìm kiếm/chi tiết Jobs chưa có router thực thi trong main; chỉ bật sau khi backend xác nhận.
VITE_JOBS_API_ENABLED=false
VITE_JOBS_LIST_PATH=
VITE_JOBS_DETAIL_PATH_TEMPLATE=
# JSON: key UI -> tên query parameter backend. Chỉ điền sau khi backend xác nhận.
VITE_JOBS_SEARCH_PARAM_MAP=
VITE_JOBS_RECOMMENDATIONS_PATH=
