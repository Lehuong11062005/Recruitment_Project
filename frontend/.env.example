# Copy file này thành .env:  copy .env.example .env   (macOS/Linux: cp .env.example .env)

# Địa chỉ API Gateway (port 8000)
VITE_API_URL=http://localhost:8000

# true  = trang đăng nhập có 3 nút vào thẳng với vai trò CANDIDATE / RECRUITER / ADMIN (không cần backend)
# false = đăng nhập thật qua POST /api/v1/auth/login
VITE_MOCK_AUTH=true
