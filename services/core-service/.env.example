# Copy file này thành ".env" (cùng thư mục) rồi điền giá trị thật. KHÔNG commit file .env
MONGO_URI=mongodb://localhost:27017/recruitment_db
# JWT_SECRET_KEY phải GIỐNG HỆT bên API Gateway (hỏi Hưởng), gửi riêng qua Zalo, không đưa lên GitHub
JWT_SECRET_KEY=doi-thanh-chuoi-bi-mat-dai-ngau-nhien
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI Service thật (services/ai-service, port 8002) ---
AI_URL=http://localhost:8002
CV_MAX_SIZE_MB=5

# --- Task 9.3: Email thông báo (SMTP). Để trống SMTP_HOST = không gửi email, chỉ ghi log ---
# Gmail: bật 2FA rồi tạo "App password" (16 ký tự) làm SMTP_PASSWORD. Không dùng mật khẩu Gmail thật.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_account@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_account@gmail.com
SMTP_USE_TLS=true
FRONTEND_URL=http://localhost:5173
